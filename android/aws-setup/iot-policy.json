{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Connect",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:REGION:ACCOUNT_ID:client/pump-app-*"
    },
    {
      "Sid": "SubscribeTelemetryAndShadow",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:REGION:ACCOUNT_ID:topicfilter/pumps/WaterPump01/telemetry",
        "arn:aws:iot:REGION:ACCOUNT_ID:topicfilter/$aws/things/WaterPump01/shadow/*"
      ]
    },
    {
      "Sid": "ReceiveMessages",
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:REGION:ACCOUNT_ID:topic/pumps/WaterPump01/telemetry",
        "arn:aws:iot:REGION:ACCOUNT_ID:topic/$aws/things/WaterPump01/shadow/*"
      ]
    },
    {
      "Sid": "PublishShadowCommands",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:REGION:ACCOUNT_ID:topic/$aws/things/WaterPump01/shadow/update",
        "arn:aws:iot:REGION:ACCOUNT_ID:topic/$aws/things/WaterPump01/shadow/get"
      ]
    }
  ]
}

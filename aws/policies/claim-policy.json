{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:ap-south-1:<ACCOUNT_ID>:client/claim-*"
    },
    {
      "Effect": "Allow",
      "Action": ["iot:Publish", "iot:Receive"],
      "Resource": [
        "arn:aws:iot:ap-south-1:<ACCOUNT_ID>:topic/$aws/certificates/create-from-csr/*",
        "arn:aws:iot:ap-south-1:<ACCOUNT_ID>:topic/$aws/provisioning-templates/agripump-fleet/provision/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:ap-south-1:<ACCOUNT_ID>:topicfilter/$aws/certificates/create-from-csr/*",
        "arn:aws:iot:ap-south-1:<ACCOUNT_ID>:topicfilter/$aws/provisioning-templates/agripump-fleet/provision/*"
      ]
    }
  ]
}

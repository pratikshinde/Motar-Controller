{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:ap-south-1:*:client/${iot:Connection.Thing.ThingName}",
      "Condition": {
        "Bool": {
          "iot:Connection.Thing.IsAttached": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:ap-south-1:*:topic/devices/${iot:Connection.Thing.ThingName}/telemetry",
        "arn:aws:iot:ap-south-1:*:topic/devices/${iot:Connection.Thing.ThingName}/faults",
        "arn:aws:iot:ap-south-1:*:topic/$aws/rules/agripump_ingest/devices/${iot:Connection.Thing.ThingName}/telemetry",
        "arn:aws:iot:ap-south-1:*:topic/$aws/rules/agripump_ingest/devices/${iot:Connection.Thing.ThingName}/faults"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": "arn:aws:iot:ap-south-1:*:topicfilter/devices/${iot:Connection.Thing.ThingName}/commands"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": "arn:aws:iot:ap-south-1:*:topic/devices/${iot:Connection.Thing.ThingName}/commands"
    }
  ]
}

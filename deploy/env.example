# Copy this file to ".env" next to docker-compose.yml and fill it in. ".env" is never committed. Generate each secret with a password manager or:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- The website ------------------------------------------------------------------------------------------------------------------
# The domain people open, for example app.yourcompany.com. Caddy gets and renews its HTTPS certificate by itself (the domain must point at this server,
# ports 80 and 443 open). For a plain-HTTP trial on a PC use :80 and set HTTP_PORT to a free port.
SITE_ADDRESS=app.example.com
#HTTP_PORT=80
#HTTPS_PORT=443

# ---- Database ---------------------------------------------------------------------------------------------------------------------
# Option A, the bundled PostgreSQL (docker compose --profile db ...): set both passwords (letters and digits only) and leave DATABASE_URL out.
POSTGRES_PASSWORD=change-me-admin-password
APP_DB_PASSWORD=change-me-app-password
# Option B, an outside PostgreSQL such as AWS RDS: set the whole address and do not use --profile db. The user must NOT be a superuser (superusers skip the
# row-level security that separates one farmer's data from another's), and must be allowed to create extensions (ltree, pgcrypto, uuid-ossp) in its database.
#DATABASE_URL=postgresql://agripump:PASSWORD@your-db-host:5432/agripump

# ---- Security ---------------------------------------------------------------------------------------------------------------------
# At least 32 random characters. Never reuse a value from a developer machine.
JWT_SECRET=
# The addresses the website is served from, as a JSON list.
CORS_ORIGINS=["https://app.example.com"]
# The platform owner's account can look but never change anything.
SUPERADMIN_MONITOR_ONLY=true
# The shared secret the AWS provisioning function sends when a starter claims its certificate: the SAME value as given to the function
# (scripts/deploy_claim_provisioning.py reads it from here).
PROVISIONING_HOOK_SECRET=

# ---- AWS --------------------------------------------------------------------------------------------------------------------------
AWS_REGION=ap-south-1
# IoT Core > Settings > Device data endpoint
IOT_DATA_ENDPOINT=
IOT_PUBLISH_MODE=aws
# The queue the readings arrive in (the IoT rule writes to it)
SQS_INGEST_URL=
# On a server give the machine an IAM role (aws/policies/backend-iam-policy.json): the containers pick it up by themselves, no keys anywhere.
# (To try the containers on a PC with your own AWS profile use docker-compose.local-aws.yml.)

# ---- Push notifications (the "power came / power went" messages) -------------------------------------------------------------------
# Put the Firebase service-account file in ./secrets and name it here as the container sees it.
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# ---- Optional ---------------------------------------------------------------------------------------------------------------------
ALERT_SMS_ENABLED=false
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_PHONE_NUMBER=

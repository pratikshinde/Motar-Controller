{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "ajanta-preview": {
      "extends": "preview",
      "env": { "BRAND": "ajanta" }
    },
    "ajanta-production": {
      "extends": "production",
      "env": { "BRAND": "ajanta" }
    }
  },
  "submit": {
    "production": {}
  }
}
